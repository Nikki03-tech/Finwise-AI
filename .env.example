PORT=3000
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional market quotes and historical prices (Twelve Data)
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_api_key

# Optional financial news search (GNews)
GNEWS_API_KEY=replace_with_your_gnews_api_key

# Optional. Leave blank when the browser UI is served from this same Express app.
FRONTEND_ORIGIN=

# Supabase Auth + private conversation history
# The anon/publishable key is safe for browser use only when RLS is enabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=
